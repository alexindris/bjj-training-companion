# Copy to .env. These credentials are for a loopback-only local database.
NEXT_TELEMETRY_DISABLED=1
POSTGRES_USER=bjj
POSTGRES_PASSWORD=bjj_local_only
POSTGRES_DB=bjj_companion
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bjj:bjj_local_only@localhost:5432/bjj_companion
BETTER_AUTH_URL=http://localhost:3000
# Replace locally: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Explicit opt-in for synthetic accounts. Never enable against a hosted database.
ALLOW_DEV_SEED=true
DEV_USER_PASSWORD=replace-with-a-local-development-password
